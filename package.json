{
  "name": "nautilus-stack",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter \"./apps/*\" dev",
    "dev:web": "bun run --filter @nautilus/web dev",
    "dev:server": "bun run --filter @nautilus/server dev",
    "build": "bun run --sequential --filter \"./apps/*\" build",
    "build:web": "bun run --filter @nautilus/web build",
    "build:server": "bun run --filter @nautilus/server build",
    "lint": "bun run --filter @nautilus/web lint",
    "typecheck": "bun run --filter \"./apps/*\" typecheck",
    "start": "bun run --filter @nautilus/web start",
    "deploy:server": "bun run --filter @nautilus/server deploy",
    "cf-typegen": "bun run --filter @nautilus/server cf-typegen",
    "dev:office": "bun run --filter @nautilus/office dev"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver",
    "workerd"
  ],
  "patchedDependencies": {
    "@univerjs/ui@1.2.0": "patches/@univerjs%2Fui@1.2.0.patch"
  }
}

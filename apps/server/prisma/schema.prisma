generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "workerd"
}

// Operator scripts and Bun integration tests cannot load workerd's WASM modules.
generator tooling {
  provider = "prisma-client"
  output   = "../src/generated/prisma-tooling"
  runtime  = "bun"
}

datasource db {
  provider = "postgresql"
}

model User {
  knowledgeBases KnowledgeBase[]
  knowledgeSources KnowledgeSource[]
  agentProgress AgentProgress[]
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  platformRole  String   @default("user")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  scheduledEvents SchedulerEvent[]
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  createdRooms  Room[]
  roomStars     RoomStar[]
  roomMessages  RoomMessage[]
  documentVersions DocumentVersion[]
  roomAgentAssignments RoomAgent[]
  roomAttachments RoomAttachment[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                     String   @id
  accountId              String
  providerId             String
  userId                 String
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  knowledgeBases KnowledgeBase[]
  id          String   @id
  name        String
  slug        String   @unique
  logo        String?
  metadata    String?
  createdAt   DateTime @default(now())
  members     Member[]
  invitations Invitation[]
  agents      Agent[]
  rooms       Room[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rooms          RoomMember[]

  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([email, status, expiresAt])
  @@index([inviterId])
  @@map("invitation")
}

enum AgentColor {
  violet
  coral
  blue
  green
  brown
  red
  orange
  amber
  teal
  pink
  gray
}

enum AgentIcon {
  bot
  sparkles
  compass
  code
  book
  chart
  circle
  oval
  square
  pill
  triangle
  hexagon
  cloud
  drop
}

enum AgentStatus {
  Working
  Available
}

model Agent {
  agentProgress AgentProgress[]
  scheduledDeliveries SchedulerDelivery[]
  id             String       @id @default(uuid())
  organizationId String
  name           String       @db.VarChar(30)
  nameKey        String
  role           String       @db.VarChar(70)
  color          AgentColor   @default(violet)
  avatarIcon     AgentIcon    @default(bot)
  avatarUrl      String?
  avatarDesign   Json?
  rules          String[]     @default([])
  status         AgentStatus  @default(Available)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  rooms          RoomAgent[]
  roomMessages   RoomMessage[]
  documentVersions DocumentVersion[]

  @@unique([organizationId, id])
  @@unique([organizationId, nameKey])
  @@index([organizationId, createdAt])
  @@map("agent")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// Local development only. Production email is delivered through the provider.
model EmailMessage {
  id        String   @id @default(cuid())
  recipient String
  subject   String
  text      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("emailMessage")
}


enum RoomStatus {
  READY
  WORKING
  NEEDS_REVIEW
}

enum RoomMemberRole {
  OWNER
  MEMBER
}

enum DocumentKind {
  DOCUMENT
  SPREADSHEET
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  READY
}

model Room {
  agentProgress AgentProgress[]
  tasks PlannerTask[]
  scheduledEvents SchedulerEvent[]
  id              String       @id @default(uuid())
  organizationId  String
  name            String       @db.VarChar(70)
  description     String       @default("") @db.VarChar(600)
  category        String       @default("General") @db.VarChar(70)
  status          RoomStatus   @default(READY)
  color           String       @default("green") @db.VarChar(20)
  createdByUserId  String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  lastActivityAt  DateTime     @default(now())
  agentWorkToken  String?
  agentWorkExpiresAt DateTime?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  members         RoomMember[]
  agents          RoomAgent[]
  stars           RoomStar[]
  messages        RoomMessage[]
  documents       Document[]
  attachments     RoomAttachment[]

  @@unique([organizationId, id])
  @@index([organizationId, lastActivityAt, id])
  @@map("room")
}

model RoomMember {
  organizationId       String
  roomId               String
  organizationMemberId String
  role                 RoomMemberRole @default(MEMBER)
  joinedAt             DateTime       @default(now())
  lastReadAt           DateTime?
  room                 Room           @relation(fields: [organizationId, roomId], references: [organizationId, id], onDelete: Cascade)
  member               Member         @relation(fields: [organizationId, organizationMemberId], references: [organizationId, id], onDelete: Cascade)

  @@id([roomId, organizationMemberId])
  @@index([organizationId, organizationMemberId])
  @@map("roomMember")
}

model RoomAgent {
  organizationId String
  roomId         String
  agentId        String
  addedByUserId  String
  position       Int      @default(0)
  addedAt        DateTime @default(now())
  addedBy        User     @relation(fields: [addedByUserId], references: [id], onDelete: Restrict)
  room           Room     @relation(fields: [organizationId, roomId], references: [organizationId, id], onDelete: Cascade)
  agent          Agent    @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Cascade)

  @@id([roomId, agentId])
  @@index([organizationId, agentId])
  @@index([addedByUserId])
  @@map("roomAgent")
}

model RoomStar {
  organizationId String
  roomId         String
  userId         String
  createdAt      DateTime @default(now())
  room           Room     @relation(fields: [organizationId, roomId], references: [organizationId, id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([organizationId, userId])
  @@map("roomStar")
}

model RoomMessage {
  knowledgeSources KnowledgeSource[]
  clientMessageId String?
  id             String   @id @default(uuid())
  organizationId String
  roomId         String
  authorUserId   String?
  authorAgentId  String?
  text           String
  createdAt      DateTime @default(now())
  editedAt       DateTime?
  room           Room     @relation(fields: [organizationId, roomId], references: [organizationId, id], onDelete: Cascade)
  authorUser     User?     @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  authorAgent    Agent?    @relation(fields: [organizationId, authorAgentId], references: [organizationId, id], onDelete: NoAction)
  documents      MessageDocument[]

  @@unique([organizationId, roomId, id])
  @@unique([roomId, authorUserId, clientMessageId])
  @@index([roomId, createdAt, id])
  @@index([authorUserId])
  @@index([organizationId, authorAgentId])
  @@map("roomMessage")
}

model Document {
  knowledgeSources KnowledgeSource[]
  id               String         @id @default(uuid())
  organizationId   String
  roomId           String
  title            String         @db.VarChar(150)
  kind             DocumentKind
  category         String         @default("Notes") @db.VarChar(70)
  status           DocumentStatus @default(DRAFT)
  currentVersionId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  room             Room           @relation(fields: [organizationId, roomId], references: [organizationId, id], onDelete: Cascade)
  versions         DocumentVersion[] @relation("DocumentVersions")
  creationReceipts  DocumentCreationReceipt[]
  currentVersion   DocumentVersion? @relation("CurrentVersion", fields: [organizationId, roomId, id, currentVersionId], references: [organizationId, roomId, documentId, id], onDelete: NoAction, onUpdate: NoAction)
  messages         MessageDocument[]

  @@unique([organizationId, roomId, id])
  @@index([organizationId, updatedAt])
  @@index([roomId, createdAt])
  @@map("document")
}

model DocumentVersion {
  id             String   @id @default(uuid())
  organizationId String
  roomId         String
  documentId     String
  versionNumber  Int
  objectKey      String   @unique
  mimeType       String
  sizeBytes      Int
  checksum       String
  authorUserId   String?
  authorAgentId  String?
  changeSummary  String?  @db.VarChar(500)
  createdAt      DateTime @default(now())
  document       Document @relation("DocumentVersions", fields: [organizationId, roomId, documentId], references: [organizationId, roomId, id], onDelete: Cascade)
  currentFor     Document[] @relation("CurrentVersion")
  authorUser     User?    @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  authorAgent    Agent?   @relation(fields: [organizationId, authorAgentId], references: [organizationId, id], onDelete: NoAction)
  messages       MessageDocument[]

  @@unique([documentId, versionNumber])
  @@unique([organizationId, roomId, documentId, id])
  @@index([authorUserId])
  @@index([organizationId, authorAgentId])
  @@map("documentVersion")
}

model MessageDocument {
  organizationId    String
  roomId            String
  messageId         String
  documentId        String
  documentVersionId String?
  message           RoomMessage @relation(fields: [organizationId, roomId, messageId], references: [organizationId, roomId, id], onDelete: Cascade)
  document          Document @relation(fields: [organizationId, roomId, documentId], references: [organizationId, roomId, id], onDelete: Cascade)
  version           DocumentVersion? @relation(fields: [organizationId, roomId, documentId, documentVersionId], references: [organizationId, roomId, documentId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([messageId, documentId])
  @@index([organizationId, roomId, documentId])
  @@map("messageDocument")
}

// Pending/deleting records retain object keys for retryable cleanup.
model RoomAttachment {
  id               String   @id @default(uuid())
  organizationId   String
  roomId           String
  filename         String   @db.VarChar(255)
  mimeType         String   @db.VarChar(255)
  sizeBytes        Int
  checksum         String
  objectKey        String   @unique
  uploadedByUserId String
  state            String   @default("PENDING")
  createdAt        DateTime @default(now())
  room             Room     @relation(fields: [organizationId, roomId], references: [organizationId, id], onDelete: Restrict)
  uploadedBy       User     @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, roomId, state, createdAt])
  @@index([uploadedByUserId])
  @@map("roomAttachment")
}

// Event content is separate from timing and per-agent delivery state.
model SchedulerEvent {
  taskId String?
  task PlannerTask? @relation(fields: [organizationId, roomId, taskId], references: [organizationId, roomId, id], onDelete: Cascade)
  id String @id @default(uuid())
  organizationId String
  roomId String
  ownerUserId String
  title String
  instruction String
  createdAt DateTime @default(now())
  room Room @relation(fields: [organizationId, roomId], references: [organizationId, id], onDelete: Cascade)
  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  schedules SchedulerSchedule[]
  @@index([organizationId, roomId, ownerUserId])
  @@map("schedulerEvent")
}

model SchedulerSchedule {
  id String @id @default(uuid())
  eventId String
  scheduledAt DateTime @db.Timestamptz(3)
  state String @default("pending")
  createdAt DateTime @default(now())
  event SchedulerEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  deliveries SchedulerDelivery[]
  @@index([state, scheduledAt])
  @@map("schedulerSchedule")
}

model SchedulerDelivery {
  executionState String?
  result String?
  executionError String?
  id String @id @default(uuid())
  scheduleId String
  organizationId String
  agentId String
  state String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @db.Timestamptz(3)
  leaseToken String?
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  acceptedAt DateTime? @db.Timestamptz(3)
  lastError String?
  schedule SchedulerSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Cascade)
  @@unique([scheduleId, agentId])
  @@index([state, nextAttemptAt])
  @@map("schedulerDelivery")
}

model PlannerTask {
  id String @id @default(uuid())
  organizationId String
  roomId String
  title String @db.VarChar(200)
  description String @default("") @db.VarChar(4000)
  status String @default("To do")
  date String @default("") @db.VarChar(10)
  agentIds String[] @default([])
  revision Int @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdByUserId String
  room Room @relation(fields: [organizationId, roomId], references: [organizationId, id], onDelete: Cascade)
  schedules SchedulerEvent[]
  changes PlannerChange[]
  @@unique([organizationId, roomId, id])
  @@index([organizationId, roomId, deletedAt, id])
  @@map("plannerTask")
}
model PlannerChange {
  id String @id @default(uuid())
  taskId String
  revision Int
  userId String
  agentId String?
  runId String?
  summary String
  snapshot Json
  createdAt DateTime @default(now())
  task PlannerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@unique([taskId, revision])
  @@map("plannerChange")
}

// Durable retry receipts are independent of agent job retention.
model DocumentCreationReceipt {
  organizationId String
  roomId         String
  userId         String
  requestId      String
  requestHash    String
  documentId     String
  versionId      String
  versionNumber  Int
  agentId        String
  runId          String
  createdAt      DateTime @default(now())
  document       Document @relation(fields: [organizationId, roomId, documentId], references: [organizationId, roomId, id], onDelete: Cascade, map: "documentCreationReceipt_document_fkey")

  @@id([organizationId, roomId, userId, requestId])
  @@index([organizationId, roomId, documentId])
  @@map("documentCreationReceipt")
}

// Private handover notes, separate from shared documents and ephemeral run checkpoints.
model AgentProgress {
  organizationId String
  roomId String
  userId String
  agentId String
  id String
  title String @db.VarChar(200)
  objective String
  completed String[]
  remaining String[]
  blockers String[]
  documents Json
  status String
  revision Int
  createdRunId String
  updatedRunId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room Room @relation(fields: [organizationId, roomId], references: [organizationId, id], onDelete: Cascade, map: "agentProgress_room_fkey")
  owner User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "agentProgress_owner_fkey")
  agent Agent @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Cascade, map: "agentProgress_agent_fkey")
  saves AgentProgressSave[]
  @@id([organizationId, roomId, userId, agentId, id])
  @@map("agentProgress")
}
model AgentProgressSave {
  organizationId String
  roomId String
  userId String
  agentId String
  requestId String
  progressId String
  requestHash String
  revision Int
  runId String
  createdAt DateTime @default(now())
  progress AgentProgress @relation(fields: [organizationId, roomId, userId, agentId, progressId], references: [organizationId, roomId, userId, agentId, id], onDelete: Cascade, map: "agentProgressSave_progress_fkey")
  @@id([organizationId, roomId, userId, agentId, requestId])
  @@index([organizationId, roomId, userId, agentId, progressId], map: "agentProgressSave_progress_idx")
  @@map("agentProgressSave")
}

// Knowledge has its own context and permissions; it never inherits room-agent chats.
enum KnowledgeScope {
  PERSONAL
  ORGANIZATION
}

model KnowledgeBase {
  id String @id @default(uuid())
  organizationId String
  scope KnowledgeScope
  ownerUserId String?
  enabled Boolean @default(true)
  nextRefreshAt DateTime @default(now()) @db.Timestamptz(3)
  lastCheckedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner User? @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  sources KnowledgeSource[]
  @@unique([organizationId, id])
  @@index([enabled, nextRefreshAt])
  @@map("knowledgeBase")
}

model KnowledgeSource {
  id String @id @default(uuid())
  knowledgeBaseId String
  organizationId String
  roomId String
  documentId String?
  messageId String?
  taggedByUserId String
  taggedAt DateTime @default(now())
  revokedAt DateTime?
  revision Int @default(1)
  lastProcessedRevision Int?
  lastProcessedVersionId String?
  lastProcessedHash String?
  lastError String?
  base KnowledgeBase @relation(fields: [organizationId, knowledgeBaseId], references: [organizationId, id], onDelete: Cascade)
  document Document? @relation(fields: [organizationId, roomId, documentId], references: [organizationId, roomId, id], onDelete: Cascade)
  message RoomMessage? @relation(fields: [organizationId, roomId, messageId], references: [organizationId, roomId, id], onDelete: Cascade)
  taggedBy User @relation(fields: [taggedByUserId], references: [id], onDelete: Cascade)
  entry KnowledgeEntry?
  runs KnowledgeRun[]
  @@unique([knowledgeBaseId, documentId])
  @@unique([knowledgeBaseId, messageId])
  @@index([organizationId, roomId])
  @@index([knowledgeBaseId, revokedAt, id])
  @@map("knowledgeSource")
}

model KnowledgeEntry {
  id String @id @default(uuid())
  sourceId String @unique
  title String @db.VarChar(200)
  body String
  revision Int @default(1)
  sourceRevision Int
  updatedAt DateTime @updatedAt
  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  revisions KnowledgeEntryRevision[]
  @@map("knowledgeEntry")
}

model KnowledgeEntryRevision {
  id String @id @default(uuid())
  entryId String
  revision Int
  sourceRevision Int
  title String
  body String
  runId String @unique
  createdAt DateTime @default(now())
  entry KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  run KnowledgeRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  citations KnowledgeCitation[]
  @@unique([entryId, revision])
  @@map("knowledgeEntryRevision")
}

model KnowledgeCitation {
  id String @id @default(uuid())
  entryRevisionId String
  documentVersionId String?
  messageHash String?
  locator String
  quote String @default("") @db.VarChar(500)
  entryRevision KnowledgeEntryRevision @relation(fields: [entryRevisionId], references: [id], onDelete: Cascade)
  @@index([entryRevisionId])
  @@map("knowledgeCitation")
}

// Each alarm processes one chunk. Checkpoints contain findings, never raw chats.
model KnowledgeRun {
  id String @id @default(uuid())
  sourceId String
  sourceRevision Int
  status String @default("pending")
  trigger String
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(3)
  leaseToken String?
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  nextChunk Int @default(0)
  findings Json @default("[]")
  documentVersionId String?
  sourceHash String?
  startedAt DateTime?
  finishedAt DateTime?
  error String?
  createdAt DateTime @default(now())
  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  entryRevision KnowledgeEntryRevision?
  @@index([status, nextAttemptAt])
  @@index([sourceId, createdAt])
  @@map("knowledgeRun")
}

{
  "name": "@nautilus/server",
  "type": "module",
  "scripts": {
    "dev": "prisma migrate status && prisma generate && wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "build": "prisma generate && wrangler deploy --dry-run --outdir dist",
    "typecheck": "prisma generate && tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "storage:reconcile": "bun scripts/reconcile-room-attachments.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:deploy": "prisma migrate deploy",
    "db:bootstrap-admin": "bun scripts/bootstrap-admin.ts",
    "test": "bun test tests",
    "test:room-attachments-live": "bun tests/room-attachments.live.ts",
    "test:room-socket": "node tests/room-chat.runtime.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.0",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "7",
    "@prisma/client": "7",
    "ai": "^7.0.155",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.12",
    "hono": "^4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "dotenv": "^18.0.9",
    "esbuild": "0.28.2",
    "miniflare": "5.20261019.2-beta",
    "prisma": "7",
    "typescript": "^5",
    "wrangler": "^4.110.0"
  },
  "private": true
}

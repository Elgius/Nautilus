{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nautilus-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": { "bindings": [{ "name": "ROOM_CHAT", "class_name": "RoomChat" }] },
  "migrations": [{ "tag": "room-chat-v1", "new_sqlite_classes": ["RoomChat"] }],
  "build": {
    "watch_dir": "src"
  }
}

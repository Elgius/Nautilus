# Runtime bindings (Wrangler loads .env locally). Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:3000
# outbox is rejected unless BETTER_AUTH_URL uses localhost.
EMAIL_DELIVERY_MODE=outbox
# Production requires EMAIL_DELIVERY_MODE=resend and both settings below.
RESEND_API_KEY=
EMAIL_FROM=
# Room document storage (optional until document contents are saved).
# Keep the bucket private; the API authorizes access and signs S3 requests.
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for temporary credentials or S3-compatible providers:
AWS_SESSION_TOKEN=
S3_ENDPOINT=

# Private Office conversion service. Match its token in apps/office/.env.
OFFICE_SERVICE_URL=http://127.0.0.1:8790
OFFICE_SERVICE_TOKEN=
